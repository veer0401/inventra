# =========================================================================
# Inventra Backend - Production Configuration Template
# Profile: prod (Activate via SPRING_PROFILES_ACTIVE=prod)
# =========================================================================

spring:
  application:
    name: inventra-backend

  datasource:
    url: ${DATABASE_URL:jdbc:postgresql://localhost:5432/inventra?options=-c%20TimeZone%3DAsia%2FKolkata}
    username: ${DATABASE_USERNAME}
    password: ${DATABASE_PASSWORD}
    driver-class-name: org.postgresql.Driver
    hikari:
      maximum-pool-size: ${DB_POOL_MAX_SIZE:20}
      minimum-idle: ${DB_POOL_MIN_IDLE:5}
      idle-timeout: ${DB_POOL_IDLE_TIMEOUT_MS:300000}
      connection-timeout: ${DB_POOL_CONN_TIMEOUT_MS:20000}
      max-lifetime: ${DB_POOL_MAX_LIFETIME_MS:1800000}
      pool-name: InventraHikariPool

  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        format_sql: false
        generate_statistics: false

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: false

  mvc:
    problemdetails:
      enabled: true

  data:
    web:
      pageable:
        default-page-size: 20
        max-page-size: 100

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: when_authorized
      probes:
        enabled: true

app:
  timezone: ${APP_TIMEZONE:Asia/Kolkata}
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS}
  jwt:
    issuer: ${JWT_ISSUER:https://api.inventra.com}
    audience: ${JWT_AUDIENCE:inventra-clients}
    secret: ${JWT_SECRET}
    access-token-expiry: ${JWT_ACCESS_EXPIRY_MS:900000} # 15 minutes
    refresh-token-expiry: ${JWT_REFRESH_EXPIRY_MS:2592000000} # 30 days
