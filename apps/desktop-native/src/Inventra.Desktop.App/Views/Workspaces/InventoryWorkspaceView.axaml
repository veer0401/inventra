<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Inventra.Desktop.App.ViewModels"
             xmlns:core="using:Inventra.Desktop.Core.Domain.Catalog"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Inventra.Desktop.App.Views.Workspaces.InventoryWorkspaceView"
             x:DataType="vm:InventoryWorkspaceViewModel"
             x:Name="InventoryWorkspaceRoot">

    <Grid>
        <!-- MAIN INVENTORY WORKSPACE -->
    <Grid RowDefinitions="Auto,*">
        <!-- 1. Top Navigation Sub-Tabs & Actions Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Classes="subtle" Content="[F1] Medicines (Catalog Master)"
                            Command="{Binding SwitchToMedicinesCommand}"/>
                    <Button Classes="subtle" Content="[F2] Stock (Store Inventory)"
                            Command="{Binding SwitchToStockCommand}"/>
                    <Button Classes="subtle" Content="[F3] Batches (FEFO Expiry Registry)"
                            Command="{Binding SwitchToBatchesCommand}"/>
                </StackPanel>

                <!-- Center Status / Notification -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NotificationMessage}" Foreground="#15803D" FontWeight="SemiBold" FontSize="11"
                               IsVisible="{Binding NotificationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Right Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Classes="primary" Content="+ Add Medicine" Command="{Binding OpenAddMedicineChoiceCommand}" Height="26" Padding="8,2" FontSize="11"/>
                    <Button Content="+ Receive Stock" Command="{Binding OpenAddStockDialogCommand}" Height="26" Padding="8,2" FontSize="11"/>
                    <Button Content="Refresh [F5]" Command="{Binding LoadProductsCommand}" Height="26" Padding="8,2" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Panels Switched by SelectedTabIndex -->
        <Panel Grid.Row="1">

            <!-- TAB 0: MEDICINES (CATALOG MASTER) -->
            <Grid RowDefinitions="Auto,*" Margin="8"
                  IsVisible="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                <!-- Filter Bar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Search:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                            <TextBox Width="280" Height="28" FontSize="12"
                                     Watermark="Search medicine name, salt, SKU..."
                                     Text="{Binding SearchQuery}"/>
                            <Button Content="Filter" Command="{Binding LoadProductsCommand}" Height="28" Padding="10,2" FontSize="11"/>
                        </StackPanel>

                        <Panel Grid.Column="1"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Classes="primary" Content="+ Add Medicine" Command="{Binding OpenAddMedicineChoiceCommand}" Height="28" Padding="10,2" FontSize="11"/>
                            <Button Content="Import from Global Catalog" Command="{Binding OpenGlobalCatalogDialogCommand}" Height="28" Padding="10,2" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Medicines DataGrid & Real Empty State -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="All"
                                  CanUserResizeColumns="True"
                                  BorderThickness="0"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU / Code" Binding="{Binding Code}" Width="95"/>

                                <DataGridTemplateColumn Header="Rx" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding PrescriptionBadgeBg}"
                                                    BorderBrush="{Binding PrescriptionBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrescriptionBadge}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding PrescriptionBadgeFg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Brand / Medicine Name" Binding="{Binding Name}" Width="2.5*"/>
                                <DataGridTextColumn Header="Generic Molecule" Binding="{Binding GenericName}" Width="2*"/>
                                <DataGridTextColumn Header="Dosage Form" Binding="{Binding DosageForm}" Width="95"/>
                                <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="85"/>
                                <DataGridTextColumn Header="Selling Unit" Binding="{Binding SellingUnit}" Width="85"/>
                                <DataGridTextColumn Header="Tax Rate" Binding="{Binding FormattedTaxRate}" Width="75"/>
                                <DataGridTextColumn Header="Price (₹)" Binding="{Binding FormattedPrice}" Width="90"/>
                                <DataGridTextColumn Header="MRP (₹)" Binding="{Binding FormattedMrp}" Width="90"/>

                                <DataGridTemplateColumn Header="Stock Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StockStatusBg}"
                                                    BorderBrush="{Binding StockStatusBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Padding="6,2"
                                                    Margin="4,2"
                                                    HorizontalAlignment="Stretch">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding FormattedStock}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{Binding StockStatusFg}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StockStatus}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{Binding StockStatusFg}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Action" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Classes="subtle" Content="Edit"
                                                    Command="{Binding $parent#InventoryWorkspaceRoot.ViewModel.OpenEditProductCommand}"
                                                    CommandParameter="{Binding}"
                                                    Height="22" Padding="6,1" FontSize="11" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Real Empty State -->
                        <Border Background="#F8FAFC"
                                IsVisible="{Binding Products.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                <TextBlock Text="No medicines in your business catalog."
                                           FontSize="16" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <TextBlock Text="Your business catalog starts empty. You can import reference formulations from the Global Medicine Catalog or create medicines locally."
                                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
                                    <Button Classes="primary" Content="Import from Global Catalog" Command="{Binding OpenGlobalCatalogDialogCommand}"/>
                                    <Button Content="Create Medicine Locally" Command="{Binding OpenCreateMedicineDialogCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 1: STOCK (STORE INVENTORY) -->
            <Grid RowDefinitions="Auto,*,Auto" Margin="8"
                  IsVisible="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                <!-- Operational KPIs Bar & Filter -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <!-- Search & Low Stock Toggle -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Filter:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                            <TextBox Width="240" Height="28" FontSize="12"
                                     Watermark="Filter stock by name, SKU..."
                                     Text="{Binding SearchQuery}"/>
                            <CheckBox Content="Low Stock (&lt;15)" IsChecked="{Binding LowStockOnly}"
                                      VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>

                        <Panel Grid.Column="1"/>

                        <!-- KPI Badges -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Total SKUs:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TotalSkuCount}" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Total Units:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TotalUnitsStock}" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Low Stock:" FontSize="11" Foreground="#B45309"/>
                                    <TextBlock Text="{Binding LowStockCount}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Out of Stock:" FontSize="11" Foreground="#B91C1C"/>
                                    <TextBlock Text="{Binding OutOfStockCount}" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                            <Button Classes="primary" Content="+ Receive Stock" Command="{Binding OpenAddStockDialogCommand}" Height="28" Padding="10,2" FontSize="11"/>
                            <Button Content="Refresh" Command="{Binding LoadProductsCommand}" Height="28" Padding="10,2" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stock DataGrid & Real Empty State -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="All"
                                  CanUserResizeColumns="True"
                                  BorderThickness="0"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU / Code" Binding="{Binding Code}" Width="95"/>
                                <DataGridTextColumn Header="Brand / Medicine Name" Binding="{Binding Name}" Width="2.5*"/>
                                <DataGridTextColumn Header="Generic Molecule" Binding="{Binding GenericName}" Width="2*"/>
                                <DataGridTextColumn Header="Dosage Form" Binding="{Binding DosageForm}" Width="95"/>
                                <DataGridTextColumn Header="Selling Unit" Binding="{Binding SellingUnit}" Width="85"/>
                                <DataGridTextColumn Header="Selling Price (₹)" Binding="{Binding FormattedPrice}" Width="100"/>
                                <DataGridTextColumn Header="MRP (₹)" Binding="{Binding FormattedMrp}" Width="100"/>

                                <DataGridTemplateColumn Header="Current Stock Level" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StockStatusBg}"
                                                    BorderBrush="{Binding StockStatusBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Padding="6,2"
                                                    Margin="4,2"
                                                    HorizontalAlignment="Stretch">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding FormattedStock}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{Binding StockStatusFg}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StockStatus}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{Binding StockStatusFg}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State -->
                        <Border Background="#F8FAFC"
                                IsVisible="{Binding Products.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                <TextBlock Text="No stock records available." FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Add medicines to your catalog or inward goods to populate stock records." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom Panel: Batch Inspector & Quick Stock Operations -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Batch List -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Active Batches (FEFO Priority):" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                                <TextBlock Text="{Binding SelectedProduct.Name}" FontWeight="Bold" FontSize="11" Foreground="#0F172A"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding SelectedProductBatches}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MaxHeight="110"
                                      GridLinesVisibility="All"
                                      BorderThickness="1"
                                      BorderBrush="#E2E8F0"
                                      FontSize="11">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Batch No." Binding="{Binding BatchNumber}" Width="120"/>
                                    <DataGridTextColumn Header="Expiry (YYYY-MM)" Binding="{Binding ExpiryDate}" Width="130"/>
                                    <DataGridTextColumn Header="Available Qty" Binding="{Binding FormattedQty}" Width="100"/>
                                    <DataGridTextColumn Header="Selling Price (₹)" Binding="{Binding FormattedPrice}" Width="110"/>
                                    <DataGridTextColumn Header="MRP (₹)" Binding="{Binding FormattedMrp}" Width="100"/>
                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ExpiryBadgeBg}"
                                                        BorderBrush="{Binding ExpiryBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="2"
                                                        Padding="4,1"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding ExpiryStatusText}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding ExpiryBadgeFg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- Quick Stock Adjust Controls -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="6">
                            <TextBlock Text="Local Stock Ops:" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="+ Receive Stock" Command="{Binding OpenAddStockDialogCommand}" Height="28" FontSize="11" Classes="primary"/>
                                <Button Content="+10 Units" Command="{Binding AddTenStockCommand}" Height="28" FontSize="11"/>
                                <Button Content="+50 Units" Command="{Binding AddFiftyStockCommand}" Height="28" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: BATCHES (FEFO EXPIRY REGISTRY) -->
            <Grid RowDefinitions="Auto,*" Margin="8"
                  IsVisible="{Binding SelectedTabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                <!-- Filter Bar & KPI Badges -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <!-- Filters -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Filter:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                            <TextBox Width="260" Height="28" FontSize="12"
                                     Watermark="Search batch #, medicine name, SKU..."
                                     Text="{Binding BatchSearchQuery}"/>
                            <CheckBox Content="Expiring Soon (&lt;90 Days)" IsChecked="{Binding ExpiringSoonOnly}"
                                      VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"/>
                            <CheckBox Content="Expired Only" IsChecked="{Binding ExpiredOnly}"
                                      VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>

                        <Panel Grid.Column="1"/>

                        <!-- KPI Badges -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Total Batches:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TotalBatchCount}" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Expiring Soon:" FontSize="11" Foreground="#B45309"/>
                                    <TextBlock Text="{Binding ExpiringSoonBatchCount}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Expired:" FontSize="11" Foreground="#B91C1C"/>
                                    <TextBlock Text="{Binding ExpiredBatchCount}" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Action -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                            <Button Content="Refresh Batches" Command="{Binding LoadAllBatchesCommand}" Height="28" Padding="10,2" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Batches DataGrid & Real Empty State -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <DataGrid ItemsSource="{Binding AllBatches}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  CanUserResizeColumns="True"
                                  BorderThickness="0"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Batch Number" Binding="{Binding BatchNumber}" Width="130"/>
                                <DataGridTextColumn Header="Medicine / Product Name" Binding="{Binding ProductName}" Width="2.5*"/>
                                <DataGridTextColumn Header="SKU / Code" Binding="{Binding ProductCode}" Width="100"/>
                                <DataGridTextColumn Header="Expiry (YYYY-MM)" Binding="{Binding ExpiryDate}" Width="120"/>
                                <DataGridTextColumn Header="Available Qty" Binding="{Binding FormattedQty}" Width="100"/>
                                <DataGridTextColumn Header="Cost Rate (₹)" Binding="{Binding FormattedCost}" Width="100"/>
                                <DataGridTextColumn Header="Selling Price (₹)" Binding="{Binding FormattedPrice}" Width="110"/>
                                <DataGridTextColumn Header="MRP (₹)" Binding="{Binding FormattedMrp}" Width="100"/>

                                <DataGridTemplateColumn Header="Expiry Status" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ExpiryBadgeBg}"
                                                    BorderBrush="{Binding ExpiryBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Padding="6,2"
                                                    Margin="2"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding ExpiryStatusText}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding ExpiryBadgeFg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Real Empty State for Batches -->
                        <Border Background="#F8FAFC"
                                IsVisible="{Binding AllBatches.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                <TextBlock Text="No inventory batches found."
                                           FontSize="15" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <TextBlock Text="Batches are created automatically when Goods Receipt Notes (GRN) are inwarded or stock is received."
                                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
                                <Button Content="Refresh Batches" Command="{Binding LoadAllBatchesCommand}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Panel>
    </Grid>

        <!-- DIALOG OVERLAY: ADD MEDICINE CHOOSER -->
        <Border Background="#80000000" IsVisible="{Binding ShowAddMedicineChoice}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Add Medicine to Catalog" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                            <TextBlock Text="Choose how you would like to introduce this medicine into your business catalog." FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle" Content="✕" Command="{Binding CloseAddMedicineChoiceCommand}" Height="24" Width="24" Padding="0"/>
                    </Grid>

                    <Separator Background="#F1F5F9" Height="1"/>

                    <!-- Choice Options -->
                    <Grid ColumnDefinitions="*,*" Margin="0,8">
                        <!-- Option A: Search Global Catalog -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                            <StackPanel Spacing="10">
                                <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                                <TextBlock Text="Global Medicine Catalog" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock Text="Search cloud platform master data. Import standardized Indian pharmaceutical formulations with pre-configured GST, dosage forms, and pack sizes."
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                <Button Classes="primary" Content="Search Global Catalog" Command="{Binding SelectSearchGlobalFromChoiceCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Option B: Create Locally -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                            <StackPanel Spacing="10">
                                <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="OFFLINE CAPABLE" FontSize="9" FontWeight="Bold" Foreground="#92400E"/>
                                </Border>
                                <TextBlock Text="Create Medicine Locally" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock Text="Create a custom product directly on this workstation. Fully operable offline, with automatic sync queuing when internet connectivity returns."
                                           FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                <Button Content="Create Medicine Locally" Command="{Binding SelectCreateLocallyFromChoiceCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Cancel" Command="{Binding CloseAddMedicineChoiceCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- DIALOG OVERLAY: CREATE MEDICINE LOCALLY -->
        <Border Background="#80000000" IsVisible="{Binding ShowCreateDialog}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Create Local Medicine (Offline Resilient)" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="Creates a business product stored locally in SQLite and queued for cloud sync." FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle" Content="✕" Command="{Binding CloseCreateMedicineDialogCommand}" Height="22" Width="22" Padding="0"/>
                    </Grid>

                    <Separator Margin="0,4"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Brand / Product Name *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewName}" Watermark="e.g. Paracetamol 500mg"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="Generic Molecule / Salt" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewGenericName}" Watermark="e.g. Paracetamol IP"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Brand Name" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewBrandName}" Watermark="e.g. Calpol"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="Manufacturer" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewManufacturer}" Watermark="e.g. GlaxoSmithKline"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Dosage Form" FontSize="11" Foreground="#475569"/>
                            <ComboBox SelectedValue="{Binding NewDosageForm}" SelectedValueBinding="{Binding Content}" HorizontalAlignment="Stretch" Height="28">
                                <ComboBoxItem Content="TABLET"/>
                                <ComboBoxItem Content="CAPSULE"/>
                                <ComboBoxItem Content="SYRUP"/>
                                <ComboBoxItem Content="INJECTION"/>
                                <ComboBoxItem Content="OINTMENT"/>
                                <ComboBoxItem Content="DROPS"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="Strength" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewStrength}" Watermark="e.g. 500mg or 10ml"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Selling Price (₹) *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewSellingPrice}" Watermark="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="Maximum Retail Price (₹) *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewMrp}" Watermark="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="GST Rate (%)" FontSize="11" Foreground="#475569"/>
                            <ComboBox SelectedValue="{Binding NewTaxRate}" HorizontalAlignment="Stretch" Height="28">
                                <x:Decimal>0.0</x:Decimal>
                                <x:Decimal>5.0</x:Decimal>
                                <x:Decimal>12.0</x:Decimal>
                                <x:Decimal>18.0</x:Decimal>
                                <x:Decimal>28.0</x:Decimal>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="3" Margin="6,0,0,6" VerticalAlignment="Center">
                            <CheckBox Content="Prescription Required (Rx)" IsChecked="{Binding NewPrescriptionRequired}" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Spacing="3" Margin="0,0,6,0">
                            <TextBlock Text="Barcode / EAN" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewBarcode}" Watermark="Scan or type barcode..."/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="1" Spacing="3" Margin="6,0,0,0">
                            <TextBlock Text="Selling Unit" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding NewSellingUnit}" Watermark="e.g. STRIP, BOTTLE"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Command="{Binding CloseCreateMedicineDialogCommand}"/>
                        <Button Classes="primary" Content="Save to Local Catalog" Command="{Binding SaveNewProductCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- DIALOG OVERLAY: GLOBAL MEDICINE CATALOG -->
        <Border Background="#80000000" IsVisible="{Binding ShowGlobalCatalogDialog}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Width="880" Height="580" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- 1. Header with Connection State Badge -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Global Medicine Master Catalog" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                            <TextBlock Text="Search cloud platform master data and import standardized Indian pharmaceutical formulations directly into your business catalog."
                                       FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <!-- Connectivity Status Badge -->
                        <Border Grid.Column="1" Background="{Binding GlobalAvailabilityBg}" BorderBrush="{Binding GlobalAvailabilityBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GlobalAvailabilityState}" FontSize="10" FontWeight="Bold" Foreground="{Binding GlobalAvailabilityFg}"/>
                        </Border>

                        <Button Grid.Column="2" Classes="subtle" Content="✕" Command="{Binding CloseGlobalCatalogDialogCommand}" Height="24" Width="24" Padding="0"/>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0,10"/>

                    <!-- 2. Main Search & Results Body -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,300">
                        <!-- Left Pane: Search & Dense DataGrid -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">
                            <!-- Search Field -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                <TextBox Grid.Column="0" Text="{Binding GlobalSearchQuery}" Watermark="Search by commercial brand, generic salt, or manufacturer..."/>
                                <Button Grid.Column="1" Classes="primary" Content="Search" Command="{Binding SearchGlobalCatalogCommand}" Margin="6,0,0,0"/>
                                <Button Grid.Column="2" Content="Create Locally" Command="{Binding OpenCreateMedicineDialogCommand}" Margin="6,0,0,0"/>
                            </Grid>

                            <!-- Results DataGrid -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                                <Grid>
                                    <DataGrid ItemsSource="{Binding GlobalSearchResults}"
                                              SelectedItem="{Binding SelectedGlobalMedicine}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              GridLinesVisibility="All"
                                              BorderThickness="0"
                                              FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Medicine Name" Binding="{Binding Name}" Width="1.8*"/>
                                            <DataGridTextColumn Header="Generic Salt" Binding="{Binding GenericName}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="1.4*"/>
                                            <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="80"/>
                                            <DataGridTextColumn Header="Form" Binding="{Binding DosageForm}" Width="75"/>
                                            <DataGridTextColumn Header="Pack" Binding="{Binding PackDisplay}" Width="80"/>
                                            <DataGridTemplateColumn Header="Action" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="core:GlobalMedicineItem">
                                                        <Button Classes="primary" Content="Import"
                                                                Command="{Binding #InventoryWorkspaceRoot.ViewModel.QuickImportMedicineCommand}"
                                                                CommandParameter="{Binding}"
                                                                Height="22" Padding="6,1" FontSize="10" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Offline / Empty Search Message -->
                                    <Border Background="#F8FAFC" Padding="20"
                                            IsVisible="{Binding GlobalSearchResults.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="Search the Global Master Catalog" FontWeight="SemiBold" FontSize="13" Foreground="#475569" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding GlobalStatusMessage}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                                            <Button Content="Create Medicine Locally" Command="{Binding OpenCreateMedicineDialogCommand}"
                                                    HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Right Pane: Medicine Detail / Preview Area -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Medicine Preview" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,8"/>

                                <!-- Details Area when Selected -->
                                <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSelectedMedicinePreview}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding SelectedGlobalMedicine.Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedGlobalMedicine.GenericName}" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>

                                        <Border Background="{Binding SelectedGlobalMedicine.PrescriptionBadgeBg}"
                                                BorderBrush="{Binding SelectedGlobalMedicine.PrescriptionBadgeBorder}"
                                                BorderThickness="1" CornerRadius="2" Padding="4,1" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding SelectedGlobalMedicine.PrescriptionBadge}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding SelectedGlobalMedicine.PrescriptionBadgeFg}"/>
                                        </Border>

                                        <Separator Background="#E2E8F0" Height="1" Margin="0,4"/>

                                        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,2">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Brand:" FontSize="10" Foreground="#64748B"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedGlobalMedicine.BrandName}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Manufacturer:" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGlobalMedicine.Manufacturer}" FontSize="10" Foreground="#0F172A" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Dosage Form:" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGlobalMedicine.DosageForm}" FontSize="10" Foreground="#0F172A" Margin="0,4,0,0"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Strength:" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedGlobalMedicine.Strength}" FontSize="10" Foreground="#0F172A" Margin="0,4,0,0"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Pack Size:" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedGlobalMedicine.PackDisplay}" FontSize="10" Foreground="#0F172A" Margin="0,4,0,0"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="HSN Code:" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedGlobalMedicine.HsnCode}" FontSize="10" Foreground="#0F172A" Margin="0,4,0,0"/>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="GST Rate:" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedGlobalMedicine.TaxRateDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Empty Preview placeholder -->
                                <TextBlock Grid.Row="1" Text="Select a medicine from search results to preview formulation details."
                                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding !HasSelectedMedicinePreview}"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HasSelectedMedicinePreview}">
                                    <Button Classes="primary" Content="Import to My Catalog"
                                            Command="{Binding ImportSelectedGlobalMedicineCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 3. Bottom Status & Close -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="{Binding GlobalStatusMessage}" FontSize="11" Foreground="#0F766E" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Close" Command="{Binding CloseGlobalCatalogDialogCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- DIALOG OVERLAY: IMPORT SUCCESS CONFIRMATION MODAL -->
        <Border Background="#80000000" IsVisible="{Binding ShowImportSuccessModal}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel Spacing="14">
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Medicine Imported to My Catalog" FontWeight="Bold" FontSize="14" Foreground="#166534"/>
                            <TextBlock Text="{Binding ImportedProductName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="Added as a business catalog item with 0 initial inventory stock." FontSize="11" Foreground="#475569"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="What would you like to do next?" FontSize="12" Foreground="#334155" FontWeight="Medium"/>

                    <StackPanel Spacing="8">
                        <Button Classes="primary" Content="Add Stock (Inward Goods)" Command="{Binding AddStockForImportedProductCommand}" HorizontalAlignment="Stretch"/>
                        <Button Content="View in Catalog Grid" Command="{Binding OpenImportedProductCommand}" HorizontalAlignment="Stretch"/>
                        <Button Content="Close" Command="{Binding CloseImportSuccessModalCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- DIALOG OVERLAY: INWARD STOCK ADJUSTMENT -->
        <Border Background="#80000000" IsVisible="{Binding ShowAddStockDialog}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Inward Stock Receipt" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="11" Foreground="#475569"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle" Content="✕" Command="{Binding CloseAddStockDialogCommand}" Height="22" Width="22" Padding="0"/>
                    </Grid>

                    <Separator Margin="0,4"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Batch Number *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding StockAddBatchNumber}" Watermark="e.g. BATCH-2026-A"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="Expiry Date (YYYY-MM) *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding StockAddExpiry}" Watermark="2028-12"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3" Margin="0,0,6,0">
                            <TextBlock Text="Received Quantity *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding StockAddQuantity}" Watermark="50"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3" Margin="6,0,0,0">
                            <TextBlock Text="Purchase Rate (₹)" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding StockAddPurchasePrice}" Watermark="0.00"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Command="{Binding CloseAddStockDialogCommand}"/>
                        <Button Classes="primary" Content="Confirm Inward Stock" Command="{Binding SaveInwardStockCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- DIALOG OVERLAY: EDIT MEDICINE -->
        <Border Background="#80000000" IsVisible="{Binding ShowEditProductDialog}">
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                    Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Edit Medicine Details" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding EditProductCode, StringFormat='Product Code: {0}'}" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle" Content="✕" Command="{Binding CloseEditProductDialogCommand}" Height="22" Width="22" Padding="0"/>
                    </Grid>

                    <Separator Margin="0,4"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Brand / Product Name *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding EditProductName}" Watermark="e.g. Paracetamol 500mg"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="Generic Molecule" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding EditProductGenericName}" Watermark="e.g. Paracetamol"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Dosage Form" FontSize="11" Foreground="#475569"/>
                            <ComboBox SelectedValue="{Binding EditProductDosageForm}" SelectedValueBinding="{Binding Content}" HorizontalAlignment="Stretch" Height="28">
                                <ComboBoxItem Content="TABLET"/>
                                <ComboBoxItem Content="CAPSULE"/>
                                <ComboBoxItem Content="SYRUP"/>
                                <ComboBoxItem Content="INJECTION"/>
                                <ComboBoxItem Content="OINTMENT"/>
                                <ComboBoxItem Content="DROPS"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="Strength" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding EditProductStrength}" Watermark="e.g. 500 mg"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Selling Unit" FontSize="11" Foreground="#475569"/>
                            <ComboBox SelectedValue="{Binding EditProductSellingUnit}" SelectedValueBinding="{Binding Content}" HorizontalAlignment="Stretch" Height="28">
                                <ComboBoxItem Content="STRIP"/>
                                <ComboBoxItem Content="BOTTLE"/>
                                <ComboBoxItem Content="VIAL"/>
                                <ComboBoxItem Content="BOX"/>
                                <ComboBoxItem Content="PIECE"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="GST Rate (%)" FontSize="11" Foreground="#475569"/>
                            <ComboBox SelectedValue="{Binding EditProductTaxRate}" HorizontalAlignment="Stretch" Height="28">
                                <x:Decimal>0.0</x:Decimal>
                                <x:Decimal>5.0</x:Decimal>
                                <x:Decimal>12.0</x:Decimal>
                                <x:Decimal>18.0</x:Decimal>
                                <x:Decimal>28.0</x:Decimal>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="3" Margin="0,0,6,6">
                            <TextBlock Text="Selling Price (₹) *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding EditProductSellingPrice}" Watermark="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3" Margin="6,0,0,6">
                            <TextBlock Text="MRP (₹) *" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding EditProductMrp}" Watermark="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <CheckBox Content="Prescription Required (Schedule H / H1 / X)" IsChecked="{Binding EditProductPrescriptionRequired}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,4"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Command="{Binding CloseEditProductDialogCommand}"/>
                        <Button Classes="primary" Content="Save Changes" Command="{Binding SaveEditProductCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
