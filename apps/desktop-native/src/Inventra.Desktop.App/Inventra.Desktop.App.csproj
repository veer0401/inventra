      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventra.Desktop.Core\Inventra.Desktop.Core.csproj" />
    <ProjectReference Include="..\Inventra.Desktop.Data\Inventra.Desktop.Data.csproj" />
